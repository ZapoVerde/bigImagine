# Copy to .env (gitignored) before deploying the stack via Dockge.
BIGBRAIN_PG_SUPERUSER=bigbrain_admin
BIGBRAIN_PG_SUPERUSER_PASSWORD=changeme
BIGBRAIN_APP_PASSWORD=changeme

# Orchestrator -> Postgres connection (the orchestrator connects as bigbrain_app, never the
# superuser — RLS only actually restricts a non-superuser role, per db/migrations/0002_schema.sql).
BIGBRAIN_PG_HOST=postgres
BIGBRAIN_PG_PORT=5432
BIGBRAIN_PG_DATABASE=bigbrain

# Reasoning LLM: named connection profiles (docs/bb_principles.md §6 — config-driven, no
# default), ST-connection-profile style — several can be defined, one is active at a time.
# "kind" is "anthropic" or "openai-compatible" (OpenRouter, DeepSeek's native endpoint, or any
# other provider speaking the standard chat-completions shape). Switching providers/models is
# changing BIGBRAIN_LLM_ACTIVE_PROFILE, not a rewrite.
# Model strings verified against each vendor's current docs at build time (deepseek-chat is
# deprecated; openrouter's "model" is only the fallback used by non-chat calls like ingestion's
# classify_note — a live Open WebUI request overrides it via the model picker, see §Phase 4).
#
# apiKey here (per named profile), BIGBRAIN_EMBEDDINGS_API_KEY, and BIGBRAIN_NOTION_TOKEN below
# are only read as a ONE-TIME SEED into the encrypted provider_credentials table
# (db/migrations/0008_provider_credentials.sql, orchestrator/src/io/providerCredentials.ts) the
# first time the orchestrator boots after that migration is applied. From then on, rotate them
# via the admin page (http://localhost:8787/v1/admin, see BIGBRAIN_ADMIN_API_KEY below and
# docker-compose.yml's loopback port) instead of editing this file — once you've confirmed a key
# rotated there, replace the real value here with the literal string "unused-managed-in-db" so a
# since-deleted DB row fails loudly at boot instead of silently falling back to a stale secret.
BIGBRAIN_LLM_PROFILES={"deepseek":{"kind":"openai-compatible","baseUrl":"https://api.deepseek.com","model":"deepseek-v4-flash","apiKey":"changeme"},"openrouter":{"kind":"openai-compatible","baseUrl":"https://openrouter.ai/api/v1","model":"google/gemini-3.5-flash-lite","apiKey":"changeme"}}
BIGBRAIN_LLM_ACTIVE_PROFILE=deepseek

# Embeddings (Document Ingestion, Phase 3). voyage-4 rather than voyage-4-large so bigBrain has
# its own free-tier token budget instead of sharing Canonize's voyage-4-large usage.
# output_dimension must match the vector(N) width in
# db/migrations/0003_phase3_schema_updates.sql — currently 2048.
# BIGBRAIN_EMBEDDINGS_API_KEY: one-time seed into provider_credentials — see the note above
# BIGBRAIN_LLM_PROFILES's apiKey fields.
BIGBRAIN_EMBEDDINGS_PROVIDER=voyage
BIGBRAIN_EMBEDDINGS_MODEL=voyage-4
BIGBRAIN_EMBEDDINGS_API_KEY=changeme
BIGBRAIN_EMBEDDINGS_OUTPUT_DIMENSION=2048

# At-rest encryption for sensitive text columns (io/fieldCipher.ts) — AES-256-GCM with a single
# server-held key. Protects against filesystem/DB access without this key (a stolen disk, a leaked
# backup); does NOT protect against whoever holds this key (i.e. you, the deployer) — that's a
# deliberate scope decision, see spec.md's corrections. Generate with: openssl rand -base64 32
BIGBRAIN_FIELD_ENCRYPTION_KEY=changeme

# Notion Sync Gateway (Phase 8). Internal connection, access-token auth, scoped to a single
# test/target page (never the whole workspace) via the connection's Content access settings.
# BIGBRAIN_NOTION_LISTS_DATA_SOURCE_ID is the data_source_id (not database_id — Notion's current
# API splits the two) of the "bigBrain Lists" database created via the API under that page.
# BIGBRAIN_NOTION_OWNER_USER_ID is the one bigBrain user any item created directly in Notion (not
# yet tracked) gets attributed to — this gateway syncs one Notion workspace to one owning user,
# not a separate workspace per household member. Any unset means Notion sync is skipped entirely
# (io/notion.ts) — lists work fully without it.
# BIGBRAIN_NOTION_TOKEN: one-time seed into provider_credentials — see the note above
# BIGBRAIN_LLM_PROFILES's apiKey fields. LISTS_DATA_SOURCE_ID/OWNER_USER_ID are not secrets
# (docs/bb_principles.md §12) but are DB-backed too (§13, orchestrator_settings via the Settings
# tab's Notion Sync section, GET/POST /v1/admin/notion-settings) — both vars below are now only
# the fallback read until someone sets a value there, not the permanent source of truth.
BIGBRAIN_NOTION_TOKEN=changeme
BIGBRAIN_NOTION_LISTS_DATA_SOURCE_ID=changeme
BIGBRAIN_NOTION_OWNER_USER_ID=changeme

# Household Calendar (spec.md §6.7), phase 1: read-only Cozi + Outlook ICS ingestion, native
# events via create_calendar_event. plugins/calendar/src/icsSync.ts polls every ~30 minutes.
# BIGBRAIN_CALENDAR_OWNER_USER_ID is the one bigBrain user Cozi/Outlook feed rows get attributed
# to (Cozi in particular is one shared family .ics URL, not per-member) — same single-owner shape
# as BIGBRAIN_NOTION_OWNER_USER_ID above, and same DB-backed-with-env-fallback shape too (Settings
# tab's Calendar section, GET/POST /v1/admin/calendar-settings). No owning user resolved (DB or
# env) disables ICS sync entirely; create_calendar_event still works either way, scoped to
# whichever user calls it.
# BIGBRAIN_COZI_ICS_URL / BIGBRAIN_OUTLOOK_ICS_URL are secrets (a feed URL grants read access to
# the whole calendar on its own) — like BIGBRAIN_NOTION_TOKEN, each is a one-time seed into
# provider_credentials ('cozi_ics_url'/'outlook_ics_url', db/migrations/0014_calendar_ics_
# credentials.sql) on first boot after being set; every boot after that reads the DB, and rotating
# either afterward is a Settings-tab action, not a .env edit (docs/bb_principles.md §12). Each is
# independently optional — set either, both, or neither. BIGBRAIN_MASK_WORK_CALENDAR=true replaces
# the Outlook feed's title/description/location with a fixed placeholder before it ever reaches
# Postgres (plugins/calendar/src/parseWorkEvent.ts) — never affects Cozi or native events. Not a
# secret, but DB-backed (§13) alongside the owning user above, same Settings tab section.
BIGBRAIN_CALENDAR_OWNER_USER_ID=changeme
BIGBRAIN_COZI_ICS_URL=
BIGBRAIN_OUTLOOK_ICS_URL=
BIGBRAIN_MASK_WORK_CALENDAR=false

# Web Search (plugins/web) — the web_search tool, backed by the Brave Search API. No user_id
# scoping applies (results aren't household data) and there's no owning-user concept like Notion/
# Calendar above. BIGBRAIN_BRAVE_API_KEY is a secret (docs/bb_principles.md §12) — like
# BIGBRAIN_NOTION_TOKEN, it's a one-time seed into provider_credentials ('brave_api_key',
# db/migrations/0016_web_search_credentials.sql) on first boot; every boot after that reads the
# DB, and rotating it afterward is a Settings-tab action, not a .env edit. Unset (DB and env)
# means web_search is simply not registered — best-effort, same as Notion sync being skipped.
BIGBRAIN_BRAVE_API_KEY=changeme

# HTTP boundary auth (Phase 4): "key:user_id" pairs, comma-separated — the only thing that
# determines which user_id a chat request is scoped to (bb_principles.md §4). Add a household
# member by inserting a users row and adding a new pair here; see db/README-users.md.
BIGBRAIN_API_KEYS=changeme:00000000-0000-0000-0000-000000000000

# Optional — Cloudflare Access SSO for bigbrain.your-domain.example only (io/accessIdentity.ts). When all
# three are set, a request carrying a valid Cf-Access-Jwt-Assertion header (Cloudflare Access adds
# this once it verifies a Google login) resolves straight to a user_id, skipping the manual API
# key above entirely. Leaving any of the three unset disables this — every request just falls back
# to BIGBRAIN_API_KEYS, exactly as before. This can never apply to Open WebUI's chat/tool traffic,
# which reaches this container directly over traefik-net, never through that hostname.
# BIGBRAIN_ACCESS_TEAM_DOMAIN and BIGBRAIN_ACCESS_AUD come from the Cloudflare Zero Trust
# dashboard: Access > Applications > (the application protecting this hostname) > Overview.
# BIGBRAIN_ACCESS_EMAILS is "email:user_id" pairs, comma-separated — same shape and same
# db/README-users.md process as BIGBRAIN_API_KEYS above, just keyed by Google email instead of a
# bearer token.
# BIGBRAIN_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# BIGBRAIN_ACCESS_AUD=changeme
# BIGBRAIN_ACCESS_EMAILS=you@gmail.com:00000000-0000-0000-0000-000000000000

# Guards GET/POST /v1/admin/credentials only (orchestrator/src/server/adminServer.ts) — a single
# static bootstrap-level key, deliberately separate from BIGBRAIN_API_KEYS above (that map has no
# admin/regular distinction and shouldn't grow one just for this). Stays in this static,
# sops-encrypted tier — it's the key that can rotate every other provider credential in the
# system, not itself something to manage through the admin UI. Generate with: openssl rand -base64 32
BIGBRAIN_ADMIN_API_KEY=changeme

# Optional — sensible defaults exist for both.
# BIGBRAIN_ORCHESTRATOR_PORT=8787
# BIGBRAIN_PLUGINS_DIR=/app/plugins

# Optional — only affects the `servers` entry in the generated OpenAPI tool spec
# (GET /v1/tools/openapi.json, orchestrator/src/server/openApiToolServer.ts). Defaults to the
# container_name Open WebUI already reaches this service by on traefik-net; only change this if
# something other than Open WebUI needs to reach the OpenAPI tool surface from elsewhere.
# BIGBRAIN_ORCHESTRATOR_BASE_URL=http://bigbrain-orchestrator:8787

# Offsite backup (backup/, docs/spec.md §6.6) — a separate sidecar container, not the
# orchestrator, so none of this is provider_credentials/DB-backed (bb_principles.md §13: this is
# bootstrap-shaped ops config for a container of its own, not orchestrator runtime config).
#
# BIGBRAIN_BACKUP_AGE_PUBLIC_KEY: the age public key backups are encrypted to before upload —
# only the holder of the matching private key (deliberately not on this host, same as the key
# that decrypts secrets.enc.env — see docs/bootstrap.md's Secrets section) can ever read a
# backup back out. Reusing that same keypair here is the simplest choice (one private key to
# keep safe, not two) but any age keypair works; generate a fresh one with:
#   age-keygen -o backup-key.txt
# and use the "public key:" line it prints.
BIGBRAIN_BACKUP_AGE_PUBLIC_KEY=age1changeme

# Optional — when to run, cron syntax (default: 3am daily). Trigger an out-of-band run any time
# with: docker exec bigbrain-backup /backup.sh
# BIGBRAIN_BACKUP_CRON_SCHEDULE=0 3 * * *

# Where backups land — any S3-compatible bucket via rclone (backup/backup.sh, backup/Dockerfile).
# Cloudflare R2 today; switching providers later (AWS S3, Backblaze B2, Wasabi, MinIO) is only
# ever changing these four values, never backup.sh or docker-compose.yml.
# BIGBRAIN_BACKUP_S3_PROVIDER (rclone's "provider" quirks flag) defaults to Cloudflare — see
# docker-compose.yml — override only if you switch providers.
# BIGBRAIN_BACKUP_S3_ENDPOINT is the account-specific R2 S3 API endpoint, from the Cloudflare
# dashboard's R2 overview page: https://<account-id>.r2.cloudflarestorage.com
# BIGBRAIN_BACKUP_S3_ACCESS_KEY_ID / BIGBRAIN_BACKUP_S3_SECRET_ACCESS_KEY: from an R2 API token
# scoped to this bucket only (Object Read & Write), not an account-wide token.
BIGBRAIN_BACKUP_S3_BUCKET=bigbrain-backups
BIGBRAIN_BACKUP_S3_ENDPOINT=https://changeme.r2.cloudflarestorage.com
BIGBRAIN_BACKUP_S3_ACCESS_KEY_ID=changeme
BIGBRAIN_BACKUP_S3_SECRET_ACCESS_KEY=changeme
